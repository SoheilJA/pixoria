# ──────────────────────────────────────────────────────────────────────
#  Pixoria — نمونهٔ فایلِ تنظیماتِ محیط
#  این فایل commit می‌شود ولی هیچ مقدارِ واقعی در آن نیست.
#  برای استفاده: کپی کنید به `.env` (لوکال) یا `.env.production` (سرور)
#  و مقدارها را پر کنید. فایل‌های واقعی در .gitignore هستند.
# ──────────────────────────────────────────────────────────────────────

# کلیدِ رمزِ Django — هر سرور باید کلیدِ مختصِ خودش را داشته باشد.
# تولیدِ کلیدِ جدید: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# حالتِ دیباگ — روی سرورِ آنلاین باید False باشد.
DEBUG=False

# دامنه‌هایی که اجازهٔ سرو شدن دارند (کاما جدا کنید).
ALLOWED_HOSTS=127.0.0.1,localhost

# Same-site protection برای CSRF — scheme://host
CSRF_TRUSTED_ORIGINS=https://example.com

# ── دیتابیس ──
# پیش‌فرض SQLite است. وقتی DATABASE_URL پر باشد، اولویت با آن است. مثال:
#   postgres://pixoria:PASSWORD@127.0.0.1:5432/pixoria
DATABASE_URL=

# ── فایل‌های استاتیک و مدیا ──
STATIC_URL=/public/static/
MEDIA_URL=/public/media/

# ── ایمیل (اختیاری) ──
# اگر تنظیم شود، فرم‌های تماس رونوشتِ پیام را ایمیل می‌کنند.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# ── URL پایهٔ سایت ──
# برای URLهای مطلق در sitemap و JSON-LD. روی لوکال خالی = از request می‌سازد.
SITE_BASE_URL=https://example.com
