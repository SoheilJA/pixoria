{% load json_tags %}{% comment %}site.webmanifest — آیکون‌ها از برندِ انتخاب‌شده در
SiteSettings می‌آیند (T58)، به همین دلیل به‌جای فایل استاتیک از یک view رندر
می‌شود. همهٔ مقادیرها با فیلتر json دورریخته می‌شوند تا یک کوتیشن یا کاراکتر
خاص داخل متن کل JSON را نشکند.{% endcomment %}
{
  "name": {{ settings.site_name|json }},
  "short_name": {{ settings.site_name|json }},
  "description": {{ settings.site_description|json }},
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0a0c",
  "theme_color": "#0a0a0c",
  "lang": "fa",
  "dir": "rtl",
  "icons": [
{% if brand.icon_192 %}    { "src": {{ brand.icon_192|json }}, "sizes": "192x192", "type": "image/png", "purpose": "any" },
{% endif %}{% if brand.icon_512 %}    { "src": {{ brand.icon_512|json }}, "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": {{ brand.icon_512|json }}, "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
{% endif %}  ]
}
